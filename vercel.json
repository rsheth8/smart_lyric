{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/config.js", "use": "@vercel/node" },
    { "src": "api/lyrics.js", "use": "@vercel/node" },
    { "src": "api/richsync.js", "use": "@vercel/node" },
    { "src": "api/genius.js", "use": "@vercel/node" },
    { "src": "api/youtube.js", "use": "@vercel/node" },
    { "src": "api/tv-pair.js", "use": "@vercel/node" },
    { "src": "app/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/config.js", "dest": "/api/config.js" },
    { "src": "/api/lyrics", "dest": "/api/lyrics.js" },
    { "src": "/api/richsync", "dest": "/api/richsync.js" },
    { "src": "/api/genius", "dest": "/api/genius.js" },
    { "src": "/api/youtube", "dest": "/api/youtube.js" },
    { "src": "/api/tv-pair", "dest": "/api/tv-pair.js" },
    { "src": "/tv", "dest": "/api/tv-pair.js?action=page" },
    { "src": "/", "dest": "/app/index.html" },
    { "src": "/(.*)", "dest": "/app/$1" }
  ],
  "headers": [
    {
      "source": "/config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
