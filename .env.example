# AcoustID API key for song recognition.
# Use the APPLICATION API key (for lookups), created here:
#   https://acoustid.org/new-application
ACOUSTID_API_KEY=your_application_api_key_here

# Spotify (optional — for Connect Spotify)
# Register at https://developer.spotify.com/dashboard
#
# Add ALL of these Redirect URIs to the Spotify Dashboard (Settings → Redirect URIs):
#   https://YOUR-PROJECT.vercel.app/     ← production web
#   http://127.0.0.1:4321/               ← local web dev (npm run dev)
#   http://127.0.0.1:18923/callback/     ← desktop app (npm start) — trailing slash required if Dashboard has it
#
# SPOTIFY_REDIRECT_URI below is only used by the web build; the desktop app always
# uses the 127.0.0.1:18923 loopback above and opens login in your system browser.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=https://YOUR-PROJECT.vercel.app/

# Apple Music (optional — for Connect Apple Music medium)
# MusicKit developer token (JWT). See https://developer.apple.com/documentation/applemusicapi
APPLE_MUSIC_DEVELOPER_TOKEN=your_musickit_developer_token
