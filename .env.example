# AcoustID API key for song recognition FROM AN AUDIO FILE (Chromaprint matches
# near-identical digital audio; it does NOT work well for a mic pointed at a
# speaker/turntable). Use the APPLICATION API key, created at:
#   https://acoustid.org/new-application
ACOUSTID_API_KEY=your_application_api_key_here

# ACRCloud (recommended for "Listen to a record" / live mic recognition).
# Landmark fingerprinting built for ambient capture — recognizes music through a
# room mic despite noise, vinyl EQ and pitch drift. Create a free "Audio & Video
# Recognition" project at https://console.acrcloud.com/ and copy its credentials.
# HOST looks like: identify-us-west-2.acrcloud.com
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# Spotify (optional — for Connect Spotify)
# Register at https://developer.spotify.com/dashboard
#
# Add ALL of these Redirect URIs to the Spotify Dashboard (Settings → Redirect URIs):
#   https://YOUR-PROJECT.vercel.app/     ← production web
#   http://127.0.0.1:4321/               ← local web dev (npm run dev)
#   http://127.0.0.1:18923/callback/     ← desktop app (npm start) — trailing slash required if Dashboard has it
#
# SPOTIFY_REDIRECT_URI below is only used by the web build; the desktop app always
# uses the 127.0.0.1:18923 loopback above and opens login in your system browser.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=https://YOUR-PROJECT.vercel.app/

# Apple Music (optional — for Connect Apple Music medium)
# MusicKit developer token (JWT). See https://developer.apple.com/documentation/applemusicapi
APPLE_MUSIC_DEVELOPER_TOKEN=your_musickit_developer_token

# Genius (optional — plain-lyrics last resort for songs no synced source has).
# Client access token from https://genius.com/api-clients. Server-side only.
# NOTE: fetching lyric text scrapes the song page (no lyrics API exists), which
# is contrary to Genius's ToS — best-effort personal use only. Leave blank to skip.
GENIUS_ACCESS_TOKEN=
